{
    "name": "libdiagnose",
    "description": "Ariadne-style compiler diagnostics for -betterC D",
    "license": "MIT",
    "targetType": "staticLibrary",
    "sourcePaths": ["source"],
    "importPaths": ["source"],
    "dependencies": {
        "libfp": {
            "repository": "git+https://github.com/doir-lang/libfp.git",
            "version": "337087d72a87cd3f05e7b67e317c4a2e3bca93b6"
        }
    },
    "dflags-ldc": ["-betterC", "-checkaction=C"],
    "dflags-dmd": ["-betterC", "-checkaction=C"],
    "configurations": [
        {
            "name": "library",
            "targetType": "staticLibrary"
        },
        {
            "name": "example",
            "targetType": "executable",
            "targetName": "diagnose-example",
            "mainSourceFile": "examples/example.d",
            "sourcePaths": ["source", "examples"],
            "importPaths": ["source", "examples"]
        },
        {
            "name": "unittest",
            "targetType": "executable",
            "targetName": "diagnose-test",
            "mainSourceFile": "tests/runner.d",
            "sourcePaths": ["source", "tests"],
            "importPaths": ["source", "tests"],
            "dflags-ldc": ["-betterC", "-checkaction=C"],
            "dflags-dmd": ["-betterC", "-checkaction=C"]
        }
    ]
}
